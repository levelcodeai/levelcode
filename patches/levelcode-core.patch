+		// [LevelCode] Never render Microsoft's hosted VS Code release notes in-editor (loadReleaseNotes
+		// hardcodes code.visualstudio.com/raw/v{ver}.md → showed "Visual Studio Code 1.126"). Open our own
+		// releases page (product.releaseNotesUrl) in the browser instead. The `useCurrentFile` dev command
+		// (Developer: Open Current File as Release Notes) still renders the local .md below.
+		if (!useCurrentFile && this._productService.releaseNotesUrl) {
+			await this._openerService.open(URI.parse(this._productService.releaseNotesUrl));
+			return true;
+		}
+
