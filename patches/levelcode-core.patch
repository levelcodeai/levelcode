diff --git a/src/vs/workbench/contrib/update/browser/releaseNotesEditor.ts b/src/vs/workbench/contrib/update/browser/releaseNotesEditor.ts
index 835f4980..f452db2c 100644
--- a/src/vs/workbench/contrib/update/browser/releaseNotesEditor.ts
+++ b/src/vs/workbench/contrib/update/browser/releaseNotesEditor.ts
@@ -91,6 +91,15 @@ export class ReleaseNotesManager extends Disposable {
 	}
 
 	public async show(version: string, useCurrentFile: boolean): Promise<boolean> {
+		// [LevelCode] Never render Microsoft's hosted VS Code release notes in-editor (loadReleaseNotes
+		// hardcodes code.visualstudio.com/raw/v{ver}.md → showed "Visual Studio Code 1.126"). Open our own
+		// releases page (product.releaseNotesUrl) in the browser instead. The `useCurrentFile` dev command
+		// (Developer: Open Current File as Release Notes) still renders the local .md below.
+		if (!useCurrentFile && this._productService.releaseNotesUrl) {
+			await this._openerService.open(URI.parse(this._productService.releaseNotesUrl));
+			return true;
+		}
+
 		const releaseNoteText = await this.loadReleaseNotes(version, useCurrentFile);
 		const base = await this.getBase(useCurrentFile);
 		this._lastMeta = { text: releaseNoteText, base };
