		"sideBar.background": "#eaeaeb",
		"sideBar.foreground": "#494b53",
		"sideBar.border": "#d4d4d4",
		"sideBarTitle.foreground": "#494b53",
		"sideBarSectionHeader.background": "#eaeaeb",
		"sideBarSectionHeader.foreground": "#383a42",
		"sideBarSectionHeader.border": "#d4d4d4",

		"activityBar.background": "#eaeaeb",
		"activityBar.foreground": "#383a42",
		"activityBar.inactiveForeground": "#a0a1a7",
		"activityBar.border": "#d4d4d4",
		"activityBarBadge.background": "#526fff",
		"activityBarBadge.foreground": "#ffffff",
		"activityBar.activeBorder": "#526fff",

		"statusBar.background": "#eaeaeb",
		"statusBar.foreground": "#494b53",
		"statusBar.border": "#d4d4d4",
		"statusBar.noFolderBackground": "#eaeaeb",
		"statusBar.debuggingBackground": "#526fff",
		"statusBar.debuggingForeground": "#ffffff",
		"statusBarItem.remoteBackground": "#526fff",
		"statusBarItem.remoteForeground": "#ffffff",
		"statusBarItem.hoverBackground": "#dbdbdc",

		"titleBar.activeBackground": "#eaeaeb",
		"titleBar.activeForeground": "#494b53",
		"titleBar.inactiveBackground": "#eaeaeb",
		"titleBar.inactiveForeground": "#a0a1a7",
		"titleBar.border": "#d4d4d4",

		"panel.background": "#eaeaeb",
		"panel.border": "#d4d4d4",
		"panelTitle.activeForeground": "#383a42",
		"panelTitle.activeBorder": "#526fff",
		"panelTitle.inactiveForeground": "#a0a1a7",

		"list.activeSelectionBackground": "#dbdbdc",
		"list.activeSelectionForeground": "#383a42",
		"list.inactiveSelectionBackground": "#dbdbdc",
		"list.hoverBackground": "#f0f0f0",
		"list.focusBackground": "#dbdbdc",
		"list.highlightForeground": "#4078f2",
		"tree.indentGuidesStroke": "#d4d4d4",

		"input.background": "#ffffff",
		"input.foreground": "#383a42",
		"input.border": "#d4d4d4",
		"input.placeholderForeground": "#a0a1a7",
		"inputOption.activeBorder": "#526fff",
		"dropdown.background": "#ffffff",
		"dropdown.foreground": "#383a42",
		"dropdown.border": "#d4d4d4",

		"button.background": "#526fff",
		"button.foreground": "#ffffff",
		"button.hoverBackground": "#6a82ff",
		"button.secondaryBackground": "#d4d4d4",
		"button.secondaryForeground": "#383a42",
		"badge.background": "#526fff",
		"badge.foreground": "#ffffff",
		"progressBar.background": "#526fff",

		"scrollbarSlider.background": "#c2c2c360",
		"scrollbarSlider.hoverBackground": "#a0a1a780",
		"scrollbarSlider.activeBackground": "#88898db0",

		"breadcrumb.foreground": "#a0a1a7",
		"breadcrumb.focusForeground": "#383a42",
		"breadcrumb.activeSelectionForeground": "#383a42",

		"terminal.background": "#fafafa",
		"terminal.foreground": "#383a42",
		"terminalCursor.foreground": "#526fff",
		"terminal.ansiBlack": "#383a42",
		"terminal.ansiRed": "#e45649",
		"terminal.ansiGreen": "#50a14f",
		"terminal.ansiYellow": "#c18401",
		"terminal.ansiBlue": "#4078f2",
		"terminal.ansiMagenta": "#a626a4",
		"terminal.ansiCyan": "#0184bc",
		"terminal.ansiWhite": "#a0a1a7",
		"terminal.ansiBrightBlack": "#a0a1a7",
		"terminal.ansiBrightRed": "#e45649",
		"terminal.ansiBrightGreen": "#50a14f",
		"terminal.ansiBrightYellow": "#c18401",
		"terminal.ansiBrightBlue": "#4078f2",
		"terminal.ansiBrightMagenta": "#a626a4",
		"terminal.ansiBrightCyan": "#0184bc",
		"terminal.ansiBrightWhite": "#383a42",

		"gitDecoration.modifiedResourceForeground": "#c18401",
		"gitDecoration.deletedResourceForeground": "#e45649",
		"gitDecoration.untrackedResourceForeground": "#50a14f",
		"gitDecoration.ignoredResourceForeground": "#a0a1a7",

		"textLink.foreground": "#4078f2",
		"textLink.activeForeground": "#1a5fd6",
		"textCodeBlock.background": "#f0f0f0",
		"textPreformat.foreground": "#50a14f"
	},
	"tokenColors": [
		{ "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#a0a1a7", "fontStyle": "italic" } },
		{ "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#50a14f" } },
		{ "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#0184bc" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#986801" } },
		{ "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"], "settings": { "foreground": "#986801" } },
		{ "scope": ["variable", "meta.definition.variable.name", "support.variable", "entity.name.variable"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["variable.parameter", "meta.function.parameters"], "settings": { "foreground": "#383a42" } },
		{ "scope": ["variable.language", "variable.language.this", "variable.language.special"], "settings": { "foreground": "#e45649", "fontStyle": "italic" } },
		{ "scope": ["variable.other.property", "meta.object-literal.key", "support.variable.property", "support.type.property-name"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["keyword", "keyword.control"], "settings": { "foreground": "#a626a4" } },
		{ "scope": ["keyword.operator", "keyword.operator.logical", "keyword.operator.arithmetic", "keyword.operator.assignment", "keyword.operator.relational", "keyword.operator.comparison"], "settings": { "foreground": "#383a42" } },
		{ "scope": ["keyword.operator.new", "keyword.operator.expression", "keyword.operator.delete", "keyword.operator.instanceof", "keyword.operator.typeof"], "settings": { "foreground": "#a626a4" } },
		{ "scope": ["storage", "storage.type", "storage.modifier", "keyword.control.import", "keyword.control.from", "keyword.control.export"], "settings": { "foreground": "#a626a4" } },
		{ "scope": ["entity.name.function", "meta.function-call", "support.function", "meta.function-call.method"], "settings": { "foreground": "#4078f2" } },
		{ "scope": ["entity.name.class", "entity.name.type", "entity.name.type.class", "support.class"], "settings": { "foreground": "#c18401" } },
		{ "scope": ["entity.other.inherited-class"], "settings": { "foreground": "#50a14f" } },
		{ "scope": ["entity.name.tag", "punctuation.definition.tag"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#986801" } },
		{ "scope": ["support.constant", "support.type", "support.type.builtin"], "settings": { "foreground": "#0184bc" } },
		{ "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"], "settings": { "foreground": "#383a42" } },
		{ "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"], "settings": { "foreground": "#a626a4" } },
		{ "scope": ["meta.decorator", "punctuation.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#4078f2" } },
		{ "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#ffffff", "background": "#e45649" } },
		{ "scope": ["markup.heading", "entity.name.section.markdown", "punctuation.definition.heading.markdown"], "settings": { "foreground": "#e45649", "fontStyle": "bold" } },
		{ "scope": ["markup.bold"], "settings": { "foreground": "#986801", "fontStyle": "bold" } },
		{ "scope": ["markup.italic"], "settings": { "foreground": "#a626a4", "fontStyle": "italic" } },
		{ "scope": ["markup.inline.raw", "markup.fenced_code.block", "markup.raw.block"], "settings": { "foreground": "#50a14f" } },
		{ "scope": ["markup.underline.link", "markup.underline.link.image"], "settings": { "foreground": "#4078f2", "fontStyle": "underline" } },
		{ "scope": ["markup.quote"], "settings": { "foreground": "#a0a1a7", "fontStyle": "italic" } },
		{ "scope": ["support.type.property-name.json"], "settings": { "foreground": "#e45649" } },
		{ "scope": ["entity.name.tag.css", "source.css support.type.property-name"], "settings": { "foreground": "#c18401" } }
	],
	"semanticTokenColors": {
		"parameter": "#383a42",
		"property": "#e45649",
		"variable.defaultLibrary": "#0184bc",
		"function.defaultLibrary": "#4078f2",
		"class": "#c18401",
		"enum": "#c18401",
		"interface": "#c18401",
		"namespace": "#383a42"
	}
}
