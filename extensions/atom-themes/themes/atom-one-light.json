		"errorForeground": "#e45649",
		"descriptionForeground": "#a0a1a7",
		"selection.background": "#dbdbdc",
		"icon.foreground": "#383a42",
		"widget.shadow": "#00000020",

		"editor.background": "#fafafa",
		"editor.foreground": "#383a42",
		"editorLineNumber.foreground": "#9d9d9f",
		"editorLineNumber.activeForeground": "#383a42",
		"editorCursor.foreground": "#526fff",
		"editor.selectionBackground": "#e5e5e6",
		"editor.selectionHighlightBackground": "#e5e5e699",
		"editor.wordHighlightBackground": "#d3d3d480",
		"editor.findMatchBackground": "#a5c2f0",
		"editor.findMatchHighlightBackground": "#bdd5f580",
		"editor.lineHighlightBackground": "#f0f0f0",
		"editorWhitespace.foreground": "#d4d4d4",
		"editorIndentGuide.background1": "#dbdbdc",
		"editorIndentGuide.activeBackground1": "#a0a1a7",
		"editorRuler.foreground": "#dbdbdc",
		"editorBracketMatch.background": "#dbdbdc80",
		"editorBracketMatch.border": "#526fff80",
		"editorGutter.background": "#fafafa",
		"editorGutter.modifiedBackground": "#c18401",
		"editorGutter.addedBackground": "#50a14f",
		"editorGutter.deletedBackground": "#e45649",
		"editorError.foreground": "#e45649",
		"editorWarning.foreground": "#c18401",
		"editorInfo.foreground": "#4078f2",

		"editorWidget.background": "#eaeaeb",
		"editorWidget.border": "#d4d4d4",
		"editorHoverWidget.background": "#eaeaeb",
		"editorHoverWidget.border": "#d4d4d4",
		"editorSuggestWidget.background": "#eaeaeb",
		"editorSuggestWidget.border": "#d4d4d4",
		"editorSuggestWidget.selectedBackground": "#dbdbdc",
		"editorSuggestWidget.highlightForeground": "#4078f2",
		"editorGroupHeader.tabsBackground": "#eaeaeb",
		"editorGroup.border": "#d4d4d4",

		"tab.activeBackground": "#fafafa",
		"tab.inactiveBackground": "#eaeaeb",
