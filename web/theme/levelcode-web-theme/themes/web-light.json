	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#a0a1a7",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#50a14f"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#0184bc"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#986801"
			}
		},
		{
			"scope": [
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#986801"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#e45649"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.function.parameters"
			],
			"settings": {
				"foreground": "#383a42"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.special"
			],
			"settings": {
				"foreground": "#e45649",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.object-literal.key",
				"support.variable.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#e45649"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control"
			],
			"settings": {
				"foreground": "#a626a4"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"keyword.operator.logical",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.relational",
				"keyword.operator.comparison"
			],
			"settings": {
				"foreground": "#383a42"
			}
		},
		{
			"scope": [
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.delete",
				"keyword.operator.instanceof",
				"keyword.operator.typeof"
			],
			"settings": {
				"foreground": "#a626a4"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control.import",
				"keyword.control.from",
				"keyword.control.export"
			],
			"settings": {
				"foreground": "#a626a4"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"meta.function-call.method"
			],
			"settings": {
				"foreground": "#4078f2"
			}
		},
		{
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"entity.name.type.class",
				"support.class"
			],
			"settings": {
				"foreground": "#c18401"
			}
		},
		{
			"scope": [
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#50a14f"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#e45649"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#986801"
			}
		},
		{
			"scope": [
				"support.constant",
				"support.type",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#0184bc"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#383a42"
			}
		},
		{
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#a626a4"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"entity.name.function.decorator"
			],
			"settings": {
				"foreground": "#4078f2"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffffff",
				"background": "#e45649"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#e45649",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#986801",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#a626a4",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#50a14f"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"markup.underline.link.image"
			],
			"settings": {
				"foreground": "#4078f2",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#a0a1a7",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"support.type.property-name.json"
			],
			"settings": {
				"foreground": "#e45649"
			}
		},
		{
			"scope": [
				"entity.name.tag.css",
				"source.css support.type.property-name"
			],
			"settings": {
				"foreground": "#c18401"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": "#383a42",
		"property": "#e45649",
		"variable.defaultLibrary": "#0184bc",
		"function.defaultLibrary": "#4078f2",
		"class": "#c18401",
		"enum": "#c18401",
		"interface": "#c18401",
		"namespace": "#383a42"
	}
}
