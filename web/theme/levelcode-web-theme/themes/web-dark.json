	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#5c6370",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"string",
				"punctuation.definition.string"
			],
			"settings": {
				"foreground": "#98c379"
			}
		},
		{
			"scope": [
				"string.regexp",
				"constant.character.escape"
			],
			"settings": {
				"foreground": "#56b6c2"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other"
			],
			"settings": {
				"foreground": "#d19a66"
			}
		},
		{
			"scope": [
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined"
			],
			"settings": {
				"foreground": "#d19a66"
			}
		},
		{
			"scope": [
				"variable",
				"meta.definition.variable.name",
				"support.variable",
				"entity.name.variable"
			],
			"settings": {
				"foreground": "#e06c75"
			}
		},
		{
			"scope": [
				"variable.parameter",
				"meta.function.parameters"
			],
			"settings": {
				"foreground": "#abb2bf"
			}
		},
		{
			"scope": [
				"variable.language",
				"variable.language.this",
				"variable.language.special"
			],
			"settings": {
				"foreground": "#e06c75",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable.other.property",
				"meta.object-literal.key",
				"support.variable.property",
				"support.type.property-name"
			],
			"settings": {
				"foreground": "#e06c75"
			}
		},
		{
			"scope": [
				"keyword",
				"keyword.control",
				"storage.type.class.jsdoc"
			],
			"settings": {
				"foreground": "#c678dd"
			}
		},
		{
			"scope": [
				"keyword.operator",
				"keyword.operator.logical",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.relational",
				"keyword.operator.comparison"
			],
			"settings": {
				"foreground": "#abb2bf"
			}
		},
		{
			"scope": [
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.delete",
				"keyword.operator.instanceof",
				"keyword.operator.typeof"
			],
			"settings": {
				"foreground": "#c678dd"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.control.import",
				"keyword.control.from",
				"keyword.control.export"
			],
			"settings": {
				"foreground": "#c678dd"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"support.function",
				"meta.function-call.method"
			],
			"settings": {
				"foreground": "#61afef"
			}
		},
		{
			"scope": [
				"entity.name.class",
				"entity.name.type",
				"entity.name.type.class",
				"support.class"
			],
			"settings": {
				"foreground": "#e5c07b"
			}
		},
		{
			"scope": [
				"entity.other.inherited-class"
			],
			"settings": {
				"foreground": "#98c379"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"punctuation.definition.tag"
			],
			"settings": {
				"foreground": "#e06c75"
			}
		},
		{
			"scope": [
				"entity.other.attribute-name"
			],
			"settings": {
				"foreground": "#d19a66"
			}
		},
		{
			"scope": [
				"support.constant",
				"support.type",
				"support.type.builtin"
			],
			"settings": {
				"foreground": "#56b6c2"
			}
		},
		{
			"scope": [
				"punctuation",
				"meta.brace",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.accessor"
			],
			"settings": {
				"foreground": "#abb2bf"
			}
		},
		{
			"scope": [
				"punctuation.definition.template-expression",
				"punctuation.section.embedded"
			],
			"settings": {
				"foreground": "#c678dd"
			}
		},
		{
			"scope": [
				"meta.decorator",
				"punctuation.decorator",
				"entity.name.function.decorator"
			],
			"settings": {
				"foreground": "#61afef"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#ffffff",
				"background": "#e06c75"
			}
		},
		{
			"scope": [
				"markup.heading",
				"entity.name.section.markdown",
				"punctuation.definition.heading.markdown"
			],
			"settings": {
				"foreground": "#e06c75",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.bold"
			],
			"settings": {
				"foreground": "#d19a66",
				"fontStyle": "bold"
			}
		},
		{
			"scope": [
				"markup.italic"
			],
			"settings": {
				"foreground": "#c678dd",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"markup.inline.raw",
				"markup.fenced_code.block",
				"markup.raw.block"
			],
			"settings": {
				"foreground": "#98c379"
			}
		},
		{
			"scope": [
				"markup.underline.link",
				"markup.underline.link.image"
			],
			"settings": {
				"foreground": "#61afef",
				"fontStyle": "underline"
			}
		},
		{
			"scope": [
				"markup.list",
				"punctuation.definition.list.begin.markdown"
			],
			"settings": {
				"foreground": "#e06c75"
			}
		},
		{
			"scope": [
				"markup.quote"
			],
			"settings": {
				"foreground": "#5c6370",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"meta.tag.sgml.doctype",
				"comment.block.documentation"
			],
			"settings": {
				"foreground": "#5c6370"
			}
		},
		{
			"scope": [
				"support.type.property-name.json",
				"support.type.property-name.json punctuation"
			],
			"settings": {
				"foreground": "#e06c75"
			}
		},
		{
			"scope": [
				"entity.name.tag.css",
				"source.css support.type.property-name"
			],
			"settings": {
				"foreground": "#e5c07b"
			}
		},
		{
			"scope": [
				"meta.attribute-selector.css",
				"entity.other.attribute-name.class.css",
				"entity.other.attribute-name.id.css"
			],
			"settings": {
				"foreground": "#d19a66"
			}
		}
	],
	"semanticTokenColors": {
		"parameter": "#abb2bf",
		"property": "#e06c75",
		"variable.defaultLibrary": "#56b6c2",
		"function.defaultLibrary": "#61afef",
		"class": "#e5c07b",
		"enum": "#e5c07b",
		"interface": "#e5c07b",
		"namespace": "#abb2bf"
	}
}
