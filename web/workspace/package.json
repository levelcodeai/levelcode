{
	"name": "levelcode-web",
	"displayName": "LevelCode Web",
	"description": "The scratch workspace and the browser-only touches of LevelCode in your browser.",
	"publisher": "levelcode",
	"version": "0.1.0",
	"license": "MIT",
	"engines": { "vscode": "^1.126.0" },
	"categories": ["Other"],
	"browser": "./extension.js",
	"enabledApiProposals": ["fileSearchProvider", "textSearchProvider"],
	"activationEvents": ["onFileSystem:levelcode-scratch", "onStartupFinished"],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": { "supported": true }
	},
	"contributes": {
		"commands": [
			{ "command": "levelcode.web.openLocalFolder", "title": "Open Folder from Your Computer…", "category": "LevelCode" },
			{ "command": "levelcode.web.openScratch", "title": "Open the Scratch Workspace", "category": "LevelCode" },
			{ "command": "levelcode.web.aboutScratch", "title": "About the Scratch Workspace", "category": "LevelCode" },
			{ "command": "levelcode.web.layout.chatFirst", "title": "Layout: Chat on Its Own", "category": "LevelCode" },
			{ "command": "levelcode.web.layout.split", "title": "Layout: Explorer, Files and Chat", "category": "LevelCode" },
			{ "command": "levelcode.web.layout.toggle", "title": "Layout: Switch", "category": "LevelCode" }
		],
		"configuration": {
			"title": "LevelCode Web",
			"properties": {
				"levelcode.web.layout": {
					"type": "string",
					"enum": ["chatFirst", "split"],
					"default": "chatFirst",
					"enumDescriptions": [
						"The chat on its own, with the conversation list beside it.",
						"The Explorer and the files, with the chat docked on the right."
					],
					"markdownDescription": "How the window is arranged. Also in the status bar and in the Command Palette under **LevelCode: Layout**."
				}
			}
		}
	}
}
